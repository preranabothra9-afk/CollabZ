# ==========================================================================
# AI MODEL PROVIDER CREDENTIALS
# ==========================================================================
# Every model below is a REAL provider adapter. Each variable is optional, but
# any model whose variable is missing will show an "API key required" notice
# instead of an answer. Keys are read on the server only and are never sent to
# the browser.
#
# The default comparison prompt uses three models from three different labs:
#   1. Gemini 3.5 Flash  -> Google AI Studio
#   2. GPT-OSS 120B      -> Groq
#   3. Qwen3.8 27B       -> Groq
#
# So a working three-model comparison only needs GEMINI_API_KEY + GROQ_API_KEY.

# GEMINI_API_KEY: Google AI Studio key. Required for the Gemini models.
# Free tier, no credit card. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_api_key"

# GROQ_API_KEY: Groq key. Powers GPT-OSS 120B/20B and Qwen3.8 27B.
# These three are on Groq's FREE plan (30 RPM, 1000 requests/day).
# Get one at https://console.groq.com/keys
# Note: llama-3.3-70b is also registered but Groq gates it behind a paid plan.
GROQ_API_KEY=""

# MISTRAL_API_KEY: Optional. Enables the Mistral Small model.
# Free Experiment tier, no credit card. Get one at https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=""

# NVIDIA_API_KEY: Optional. Enables the DeepSeek R1 model.
# Free developer tier, 40 RPM. Get one at https://build.nvidia.com
NVIDIA_API_KEY=""

# JWT_ACCESS_SECRET: Cryptographic secret for signing access tokens
JWT_ACCESS_SECRET="synapse-ai-access-quantum-secret-2026"

# JWT_REFRESH_SECRET: Cryptographic secret for signing refresh tokens
JWT_REFRESH_SECRET="synapse-ai-refresh-quantum-secret-2026"

# CLIENT_URL: The trusted web address (domain/URL) where the browser interface of the application is running. 
# The server uses this to securely let your browser talk to backend APIs and web sockets (CORS).
CLIENT_URL="http://localhost:3000"

# NODE_ENV: Runtime deployment tier (e.g., development, production)
NODE_ENV="development"

# JWT_SECRET: Security token decryption seed for authenticating collaborators.
JWT_SECRET="synapse-ai-exclusive-quantum-secret-2026"

# MONGODB_URI: (Optional) The connection URI for your MongoDB database (e.g. MongoDB Atlas).
# If not provided, CollabZ automatically runs in high-performance Local JSON Persistent mode.
MONGODB_URI="MongoDB Atlas URI"

# Initial Platform Administration Credentials (MERN System Startup Auto-Seeder)
ADMIN_NAME="System Super Administrator"
ADMIN_EMAIL="admin@synapse.ai"
ADMIN_PASSWORD="Password@123"

# ==========================================================================
# EMAIL DELIVERY (OPTIONAL)
# ==========================================================================
# Required for email verification and password reset emails. While these are
# blank, the app runs in "no mail" mode: verification and reset links are
# returned through the corresponding API response instead of being emailed,
# so the flows can still be tested end to end locally.
#
# For Gmail, create an App Password (not your account password) at
# https://myaccount.google.com/apppasswords and enable 2-Step Verification first.
# SMTP_HOST and SMTP_PORT default to smtp.gmail.com / 587 when omitted.

SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_NAME="CollabZ"
APP_URL="http://localhost:3000"
